# Local data paths — copy this file to .env and fill in your paths.
# .env is gitignored and never committed.

# Raw GPS data
GPS_DIR=/path/to/gps_dataset
TRIPS_PATH=/path/to/trips_dataset.csv

# Pre-generated features from the original pipeline (for validation only)
DATA_FEATURES_DIR=/path/to/DATA_Feature_sets

# Optional: GTFS feeds for stop proximity features
GTFS_DIR=/path/to/gtfs

# Optional: Pre-extracted OSM route parquets for route matching features
OSM_ROUTES_DIR=/path/to/osm_routes
